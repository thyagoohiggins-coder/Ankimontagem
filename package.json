{
  "name": "montador-flashcards",
  "productName": "Montador de Flashcards",
  "version": "1.0.0",
  "description": "Montador de flashcards com aprofundamento por trechos destacados",
  "main": "main.js",
  "author": "Montador de Flashcards",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable",
    "dist:win-zip": "electron-builder --win zip"
  },
  "build": {
    "appId": "com.montador.flashcards",
    "productName": "Montador de Flashcards",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "app.js",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Montador de Flashcards"
    },
    "portable": {
      "artifactName": "MontadorDeFlashcards-portatil-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "26.0.12"
  }
}
